# Jira Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-jira --about` for the
# authoritative list.

# Required: OAuth client ID for the Jira OAuth app
TAP_JIRA_CLIENT_ID=your_client_id_here

# Required: OAuth client secret for the Jira OAuth app
TAP_JIRA_CLIENT_SECRET=your_client_secret_here

# Optional: OAuth refresh token (if your flow uses one)
TAP_JIRA_REFRESH_TOKEN=your_refresh_token_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_JIRA_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://api.atlassian.com)
TAP_JIRA_API_URL=https://api.atlassian.com
